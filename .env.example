# ==========================================
# ProjectEval Configuration Environment Variables
# ==========================================

# Database Configuration
POSTGRES_DB=projecteval
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
DB_URL=jdbc:postgresql://localhost:5432/projecteval
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword

# Spring Environment Profile (postgres or h2)
SPRING_PROFILES_ACTIVE=postgres

# JWT Security Key (HS256 256-bit base64 secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Docker Sandbox Settings
SANDBOX_DIR=./eval-workspace
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0

# Server Ports
PORT_BACKEND=8080
PORT_FRONTEND=5173
PORT_FRONTEND_PROD=3000
